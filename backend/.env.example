# GROQ API Configuration
GROQ_API_KEY=your_groq_api_key_here

# Optional provider keys (server-level fallbacks / embeddings). Per-user keys live in the DB.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Auth
# SECRET_KEY must be set to a long, random value in any non-local environment —
# it signs JWTs; the default is dev-only and insecure.
SECRET_KEY=dev-only-insecure-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Encryption key for stored provider API keys (Fernet urlsafe base64 key).
ENCRYPTION_KEY=

# Server Configuration
PORT=8000
HOST=127.0.0.1

# CORS_ORIGINS is a JSON list of allowed origins, e.g. CORS_ORIGINS=["http://localhost:9002"]
CORS_ORIGINS=["http://localhost:9002", "http://127.0.0.1:9002"]

# Database Configuration
DATABASE_URL=sqlite:///./uni_chat.db

# Optional: For production deployment
# PORT=80
# HOST=0.0.0.0
# DATABASE_URL=postgresql://user:password@localhost/uni_chat
